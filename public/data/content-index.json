        "portraits": [
          {
            "id": "database",
            "name": "database",
            "introduce": "Ray的人员档案库。它进行尽责的记录着所见到的每一个人。\n硅基将可查询范围内的知识集称之为”智能沼泽“或者”智池“，如果有人类的思想创意能够超出智池范畴，其发言会被硅基们奉为圭臬，并汲取，记录。阅读大量失落媒体或失传纸质图书的人，创造性的艺术家，富有想象力的作者……而然，有学者发现，还有一类人容易被硅基记录在案——富有创意的抽象的弱智。",
            "image_url": "https://cdn.cosmicbroth.com/IMG_3795_20250817_152046_e4d8a513de.PNG",
            "json_shape": "array<{name,information,portraits:[{image_url,content}]}>",
            "role_count": 11,
            "roles": [
              {
                "name": "Meme",
                "portrait_count": 4
