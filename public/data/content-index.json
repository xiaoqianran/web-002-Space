{
  "source": "https://api.cosmicbroth.com/api",
  "site": "https://www.cosmicbroth.com/",
  "cdn": "https://cdn.cosmicbroth.com/",
  "schemas": {
    "record_meta": {
      "shape": "object",
      "keys": [
        "id",
        "name",
        "image_url",
        "type",
        "time",
        "instrution",
        "world",
        "worldId",
        "chapters"
      ],
      "notes": "instrution is a typo in the API (instruction). chapters is a list of chapter title strings.",
      "sample_file": "api/records/goldfish.json"
    },
    "chapter": {
      "shape": "array<string>",
      "keys": null,
      "notes": "Plain list of paragraph strings; no title/id fields. Title lives on the parent record.chapters[i].",
      "sample_file": "api/records/goldfish_c1.json",
      "sample_len": 32
    },
    "portrait": {
      "shape": "array<object>",
      "keys": [
        "name",
        "information",
        "portraits"
      ],
      "portraits_item_keys": [
        "image_url",
        "content"
      ],
      "notes": "Each entry is a character/role with a gallery of portraits.",
      "sample_file": "api/portraits/database.json",
      "sample_len": 11
    },
    "image": {
      "shape": "array<object>",
      "keys": [
        "image_url",
        "instrution"
      ],
      "notes": "Gallery of images with caption/instruction text (instrution typo).",
      "sample_file": "api/images/vlog.json",
      "sample_len": 21
    },
    "outline": {
      "shape": "array<object>",
      "keys": [
        "contents",
        "image"
      ],
      "notes": "World intro scroll sections; image is a CDN URL.",
      "sample_file": "api/outline/cosmic-broth.json",
      "sample_len": 2
    }
  },
